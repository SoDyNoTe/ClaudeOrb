{
  "name": "claudeorb",
  "productName": "ClaudeOrb",
  "version": "1.0.7",
  "description": "Mac menubar companion app for Claude Code usage stats",
  "author": "Alexander Herbst",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.claudeorb.app",
    "productName": "ClaudeOrb",
    "mac": {
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "artifactName": "ClaudeOrb-arm64.dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "SoDyNoTe",
      "repo": "ClaudeOrb"
    },
    "win": {
      "icon": "assets/icon-win.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ClaudeOrb-Setup.${ext}",
      "shortcutName": "ClaudeOrb"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "menubar": "^9.4.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1"
  }
}
